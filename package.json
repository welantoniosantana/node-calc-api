{
  "name": "calc-api",
  "version": "1.0.0",
  "description": "API simples de cálculos matemáticos com Node, Docker e testes",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.1.3",
    "vitest": "^2.0.5",
    "@vitest/coverage-v8": "^2.0.5"
  },
  "vitest": {
    "test": {
      "coverage": {
        "provider": "v8",
        "reporter": ["text", "lcov"],
        "reportsDirectory": "coverage"
      }
    }
  }
}
